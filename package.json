{
  "name": "volter-editor-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:blender-three": "npm run build:blender-three -w @volter/blender-engine",
    "build": "node scripts/build-release-packages.mjs && node scripts/write-bundled-notices.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test": "npm run test:session -w @volter/editor-core && node --test packages/editor-core/test/history.test.mjs packages/blender-engine/test/world-field.test.mjs packages/blender-engine/test/shutdown.test.mjs && python3 packages/blender-engine/test/native_history.py",
    "check:packed-imports": "node scripts/check-packed-imports.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "three": "0.180.0",
    "@types/three": "0.180.0",
    "zod": "4.3.6",
    "@types/node": "25.9.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.8.0",
    "pixi.js": "8.19.0",
    "@fortawesome/fontawesome-svg-core": "7.2.0",
    "@fortawesome/free-solid-svg-icons": "7.2.0",
    "@volter-ai-dev/supercode-frontend-vscode": "0.1.3"
  }
}
