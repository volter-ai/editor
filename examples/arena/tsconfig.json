{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@volter/editor-project/*": [
        "../../node_modules/@volter/editor-project/src/*"
      ],
      "@volter/threejs-runtime/*": [
        "../../node_modules/@volter/threejs-runtime/src/*"
      ],
      "@volter/game-runtime/*": [
        "../../node_modules/@volter/game-runtime/src/*"
      ],
      "@editor/*": [
        "../../node_modules/@volter/editor-core/src/*"
      ]
    },
    "incremental": true,
    "tsBuildInfoFile": "../../.tsbuildinfo/example-arena-main.tsbuildinfo"
  },
  "include": [
    "src",
    "vgai.adapter.ts"
  ],
  "exclude": [
    "src/tools",
    "src/contributions"
  ]
}
