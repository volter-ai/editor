# Dependencies
node_modules/

# Build output
dist/
dist-server/
*.local

# Vite cache
.vite/

# Editor autosaved UI state (panel layout etc.) — local-machine ephemeral.
# NOT the rest of .volter/: .volter/scaffold-baseline.json is committed project
# state: the scaffold's record of the files it wrote (node/scaffold/baseline.ts),
# and .volter/overlays/*.json + .volter/thumbnail.png + .volter/provenance.json +
# .volter/generations.json are real project data too.
.volter/editor-state.json
# #146 — more local-machine ephemera: the live session's discovery file
# (written by the dev server at boot, removed on shutdown) and agent
# screenshot captures (GET /__volter/screenshot).
.volter/session.json
.volter/collaboration.json
.volter/captures/
.volter/tmp/
.volter/last-run/
# `volter-game-editor screenshot`'s default output directory — looking at the game is the
# documented way to verify it, so an ordinary session leaves dozens of PNGs here.
.volter/screenshots/
# Run artifacts a driving script writes (screenshots a failure block points at,
# the last run's scratch). Overwritten every run — nothing here is worth
# committing.
.volter/prev-run/
# The build-discipline tripwires' announce gate — machine-local, and it MUST stay
# untracked: a tracked gate file would add itself to the very dirty-file count the
# commit-cadence tripwire reports.
.volter/tripwire-gate.json
# Rebuildable Scene/Canvas Content preview images. Authored framing remains in
# .volter/thumbnails.json; only these generated pixels are machine-local.
.volter/cache/document-previews/

# The Blender session's own scratch document. The weapon bake drives the
# editor session's Blender, and the standing Model document saves its scene to
# models/model.blend on the way out — an ~850 KB .blend that is session debris,
# not this project's source. The project's OWN Blender documents are tracked,
# under src/models/ with the rest of its source — which is why this pattern is
# ANCHORED: a bare `models/` matches at every depth and would have swallowed
# src/models/arena-weapons.blend silently.
/models/

# `volter-game-editor play`'s run logs (logs/play-*.jsonl)
logs/
*.jsonl

# Playwright / test output
test-results/
playwright-report/
.playwright-mcp/

# OS junk
.DS_Store
Thumbs.db

# Local env files
.env
.env.local
.env.*.local

# ztrack (added by ztrack init)
.volter/tracker/tracker.sqlite
.volter/tracker/tracker.sqlite-*
.volter/tracker/tracker.sqlite.lock
.volter/tracker/local-store.json
.volter/agent-dispatch/
.volter/github/
.volter/sync/
.volter/.ztrack-loop.json
.volter/.ztrack-loop-iter-*
.volter/.ztrack-loop-exempt-*
.volter/.ztrack-loop-capped.json
# ztrack also writes .volter/tracker/.gitignore covering the audit files below.
# Restated here because npm strips every nested .gitignore from a package
# tarball (the same fact `restorePackagedTemplateDotfiles` exists for), so a
# project scaffolded from the PACKAGED editor never receives that file.
.volter/tracker/.audit.jsonl
.volter/tracker/.audit-state.json
.volter/tracker/.audit.lock
.volter/workbench-storage.json
