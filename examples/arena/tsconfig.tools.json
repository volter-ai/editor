{
  // `exclude` MUST be reset: `extends` inherits the base config's
  // `exclude: ["editor/tools", "editor/contributions"]`, and exclude beats include — inheriting it makes
  // this program compile ZERO files while still exiting 0. Tools are NODE
  // code (see editor/tools/module-source.ts), which is why the base browser
  // program excludes them; `types` adds node back here.
  "extends": "./tsconfig.json",
  "include": [
    "editor/tools",
    "editor/contributions",
    // `scripts/play-perspective.ts` is the entry both run configurations start
    // (`npx tsx`) — Node code like the tools, and checked here for the same
    // reason. The other scripts beside it are `.mjs` and have no program.
    "scripts/**/*.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "types": [
      "vite/client",
      "node"
    ],
    "incremental": true,
    "tsBuildInfoFile": "../../.tsbuildinfo/example-arena-tools.tsbuildinfo"
  }
}
