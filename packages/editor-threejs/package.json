{
  "name": "@volter/editor-threejs",
  "author": "Volter AI, Inc.",
  "version": "0.5.66",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "AGPL-3.0-only AND Apache-2.0",
  "description": "Shared Three.js bounds, rendering and capture utilities used by Volter Editor.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/editor.git",
    "directory": "packages/editor-threejs"
  },
  "files": [
    "src",
    "serving",
    "contributions",
    "dist-node",
    "LICENSE",
    "NOTICE",
    "LICENSE-APACHE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./contributions/*": "./contributions/*",
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*"
    },
    "./asset-parse-error": "./src/asset-parse-error.ts",
    "./loader": "./src/loader.ts"
  },
  "peerDependencies": {
    "three": "^0.180.0",
    "vite": "^6.4.3"
  },
  "scripts": {
    "build": "node scripts/build-serving.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "vgai": {
    "contributions": [
      "./contributions/animation-mixers.service.ts"
    ],
    "serving": "./dist-node/serving.mjs"
  },
  "dependencies": {
    "@volter/editor-project": "0.5.66",
    "@sparkjsdev/spark": "^2.1.0",
    "three.quarks": "^0.16.0",
    "zod": "^4.3.6",
    "typescript": "5.9.3",
    "@volter/editor-sdk": "0.5.66"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
