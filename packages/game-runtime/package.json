{
  "name": "@volter/game-runtime",
  "author": "Volter AI, Inc.",
  "license": "Apache-2.0",
  "version": "0.5.66",
  "publishConfig": {
    "access": "public"
  },
  "description": "THE GAME SHIPPED TWIN: what a shipped game carries because it is a GAME \u2014 the host game loop and phase runner, the mount and its adapter registry, input, audio, the dev instruments, data assets and their Vite plugin, the React bindings, the Pixi canvas substrate, and the R3F mount that puts a three.js world inside that host.",
  "keywords": [
    "vgai",
    "game-engine",
    "game-loop"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/editor.git",
    "directory": "packages/game-runtime"
  },
  "exports": {
    "./canvas-react": "./src/canvas-react/index.ts",
    "./config": {
      "types": "./src/config.ts",
      "default": "./dist-config/config.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./src/*"
    }
  },
  "files": [
    "src",
    "dist-config",
    "schemas",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node build-config.mjs",
    "dev": "node watch.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.14.0",
    "@pixi/react": "8.0.5",
    "@volter/threejs-runtime": "0.5.66",
    "loglayer": "^9.1.0",
    "pixi.js": "^8.6.0",
    "three": "^0.180.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "esbuild": "^0.25.12",
    "react": "^19.2.4",
    "typescript": "^5.6.0"
  }
}
