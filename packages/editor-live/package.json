{
  "name": "@volter/editor-live",
  "author": "Volter AI, Inc.",
  "version": "0.5.64",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "Apache-2.0",
  "description": "Attach to Volter Editor sessions for document and modeling automation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/editor.git",
    "directory": "packages/editor-live"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "BUNDLED_NOTICES"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@volter/editor-sdk": "0.5.64",
    "@volter/editor-project": "0.5.64",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/session.test.mjs"
  }
}
