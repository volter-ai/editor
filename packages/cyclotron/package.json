{
  "name": "@volter/cyclotron",
  "author": "Volter AI, Inc.",
  "version": "0.5.194",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only AND GPL-3.0-or-later AND MIT",
  "description": "A free, open-source game editor by VideoGame AI using Blender 5.2 compiled to WebAssembly, Code-OSS, three.js, TypeScript and React.",
  "homepage": "https://cyclotron.videogame.ai",
  "keywords": [
    "blender",
    "three.js",
    "game editor",
    "webassembly",
    "code-oss",
    "react",
    "mcp",
    "codex",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/editor.git",
    "directory": "packages/cyclotron"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "LICENSE",
    "LICENSE-BLENDER",
    "NOTICE",
    "dist-node",
    "presets.mjs",
    "starter",
    "LICENSE-MCP",
    "BUNDLED_NOTICES"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "build:node": "node scripts/build-node.mjs",
    "typecheck": "tsc -p tsconfig.node.json",
    "test": "npm run build:node && node --test test/first-run.test.mjs"
  },
  "volter": {
    "product": {
      "entry": "./src/index.ts",
      "displayName": "Volter Cyclotron",
      "install": "npx @volter/cyclotron create my-game",
      "colorTheme": "dark",
      "upgrade": true,
      "workbench": {
        "darwin-arm64": {
          "release": "cyclotron-f16dc165c0df-a455d637cd33-darwin-arm64",
          "tarballSha256": "2385a7a3f3a50062d8b16ee3c220a668fe478d921f1f7e61944ded424986a98d"
        },
        "linux-x64": {
          "release": "cyclotron-f16dc165c0df-a455d637cd33-linux-x64",
          "tarballSha256": "466a23908f1c15e90ae31faef70111b0cfafcf7dd05acc0cd261853fb0aa4d81"
        },
        "win32-x64": {
          "release": "cyclotron-f16dc165c0df-a455d637cd33-win32-x64",
          "tarballSha256": "65b407facc9c8ba6dd33ec1a2de21f243ab8a01ab4dfdf7de818264dfd7304cc"
        }
      }
    }
  },
  "dependencies": {
    "@volter/editor-core": "0.5.194",
    "@volter/editor-blender": "0.1.133",
    "@volter/editor-threejs": "0.5.194",
    "@volter/blender-engine": "0.1.131",
    "@volter/editor-project": "0.5.194",
    "@volter/editor-sdk": "0.5.194",
    "@volter/editor-live": "0.5.194",
    "@modelcontextprotocol/sdk": "1.32.1",
    "undici": "7.29.1"
  },
  "bin": {
    "cyclotron": "./dist-node/cli.js"
  }
}
