{
  "name": "@volter/cyclotron",
  "author": "Volter AI, Inc.",
  "version": "0.5.197",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only AND GPL-3.0-or-later AND MIT",
  "description": "A free, open-source game editor by VideoGame AI using Blender 5.2 compiled to WebAssembly, Code-OSS, three.js, TypeScript and React.",
  "homepage": "https://cyclotron.videogame.ai",
  "keywords": [
    "blender",
    "three.js",
    "game editor",
    "webassembly",
    "code-oss",
    "react",
    "mcp",
    "codex",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/editor.git",
    "directory": "packages/cyclotron"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "LICENSE",
    "LICENSE-BLENDER",
    "NOTICE",
    "dist-node",
    "presets.mjs",
    "starter",
    "LICENSE-MCP",
    "BUNDLED_NOTICES"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "build:node": "node scripts/build-node.mjs",
    "typecheck": "tsc -p tsconfig.node.json",
    "test": "npm run build:node && node --test test/first-run.test.mjs"
  },
  "volter": {
    "product": {
      "entry": "./src/index.ts",
      "displayName": "Volter Cyclotron",
      "install": "npx @volter/cyclotron create my-game",
      "colorTheme": "dark",
      "upgrade": true,
      "workbench": {
        "darwin-arm64": {
          "release": "cyclotron-f16dc165c0df-2d5aeb1b4cd7-darwin-arm64",
          "tarballSha256": "5db124b24aeb0f59291011b58de8c785218411f7ddbdf82ab3d0d3d7ae27a2a3"
        },
        "linux-x64": {
          "release": "cyclotron-f16dc165c0df-2d5aeb1b4cd7-linux-x64",
          "tarballSha256": "3a435ef2084ab063330b83fa67477773a07170b5f5992a2f0546db691af488f8"
        },
        "win32-x64": {
          "release": "cyclotron-f16dc165c0df-2d5aeb1b4cd7-win32-x64",
          "tarballSha256": "96389b6a0c6430daf08a282425c3cda81af211e60607819782aab27922617eee"
        }
      }
    }
  },
  "dependencies": {
    "@volter/editor-core": "0.5.197",
    "@volter/editor-blender": "0.1.136",
    "@volter/editor-threejs": "0.5.197",
    "@volter/blender-engine": "0.1.134",
    "@volter/editor-project": "0.5.197",
    "@volter/editor-sdk": "0.5.197",
    "@volter/editor-live": "0.5.197",
    "@modelcontextprotocol/sdk": "1.32.1",
    "undici": "7.29.1"
  },
  "bin": {
    "cyclotron": "./dist-node/cli.js"
  }
}
