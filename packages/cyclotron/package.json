{
  "name": "@volter/cyclotron",
  "author": "Volter AI, Inc.",
  "version": "0.5.202",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only AND GPL-3.0-or-later AND MIT",
  "description": "A free, open-source game editor by VideoGame AI using Blender 5.2 compiled to WebAssembly, Code-OSS, three.js, TypeScript and React.",
  "homepage": "https://cyclotron.videogame.ai",
  "keywords": [
    "blender",
    "three.js",
    "game editor",
    "webassembly",
    "code-oss",
    "react",
    "mcp",
    "codex",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/editor.git",
    "directory": "packages/cyclotron"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "LICENSE",
    "LICENSE-BLENDER",
    "NOTICE",
    "dist-node",
    "presets.mjs",
    "starter",
    "LICENSE-MCP",
    "BUNDLED_NOTICES"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "build:node": "node scripts/build-node.mjs",
    "typecheck": "tsc -p tsconfig.node.json",
    "test": "npm run build:node && node --test test/first-run.test.mjs"
  },
  "volter": {
    "product": {
      "entry": "./src/index.ts",
      "displayName": "Volter Cyclotron",
      "install": "npx @volter/cyclotron create my-game",
      "colorTheme": "dark",
      "upgrade": true,
      "workbench": {
        "darwin-arm64": {
          "release": "cyclotron-f16dc165c0df-28b19dec3e1a-darwin-arm64",
          "tarballSha256": "5bc0f4df6b89477e7563afd83e2bdab5ddebac565ed55fb8af634225d5e6fe63"
        },
        "linux-x64": {
          "release": "cyclotron-f16dc165c0df-28b19dec3e1a-linux-x64",
          "tarballSha256": "f091a9d6759adb06089e6db35d2be08ac747a154b93904cb5d0da0eba8ca2964"
        },
        "win32-x64": {
          "release": "cyclotron-f16dc165c0df-28b19dec3e1a-win32-x64",
          "tarballSha256": "f5fe532a1571fd34a6b5b1f1c10b6c92e933be4132c164ed9ca35ee557587162"
        }
      }
    }
  },
  "dependencies": {
    "@volter/editor-core": "0.5.202",
    "@volter/editor-blender": "0.1.141",
    "@volter/editor-threejs": "0.5.202",
    "@volter/blender-engine": "0.1.139",
    "@volter/editor-project": "0.5.202",
    "@volter/editor-sdk": "0.5.202",
    "@volter/editor-live": "0.5.202",
    "@modelcontextprotocol/sdk": "1.32.1",
    "undici": "7.29.1"
  },
  "bin": {
    "cyclotron": "./dist-node/cli.js"
  }
}
