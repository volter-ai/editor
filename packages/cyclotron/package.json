{
  "name": "@volter/cyclotron",
  "author": "Volter AI, Inc.",
  "version": "0.5.204",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only AND GPL-3.0-or-later AND MIT",
  "description": "A free, open-source game editor by videogame.ai using Blender 5.2 compiled to WebAssembly, Code-OSS, three.js, TypeScript and React.",
  "homepage": "https://cyclotron.videogame.ai",
  "keywords": [
    "blender",
    "three.js",
    "game editor",
    "webassembly",
    "code-oss",
    "react",
    "mcp",
    "codex",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/editor.git",
    "directory": "packages/cyclotron"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "LICENSE",
    "LICENSE-BLENDER",
    "NOTICE",
    "dist-node",
    "presets.mjs",
    "starter",
    "LICENSE-MCP",
    "BUNDLED_NOTICES"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "build:node": "node scripts/build-node.mjs",
    "typecheck": "tsc -p tsconfig.node.json",
    "test": "npm run build:node && node --test test/first-run.test.mjs"
  },
  "volter": {
    "product": {
      "entry": "./src/index.ts",
      "displayName": "Volter Cyclotron",
      "install": "npx @volter/cyclotron create my-game",
      "colorTheme": "dark",
      "upgrade": true,
      "adapterRequired": true,
      "workbench": {
        "darwin-arm64": {
          "release": "cyclotron-4782d9a281ef-ec1e0e845c3a-darwin-arm64",
          "tarballSha256": "2a57c0cbc8baa64114d727fe9be00e849f5b8257a8416b50189017f247982c55"
        },
        "linux-x64": {
          "release": "cyclotron-4782d9a281ef-9a813b17c0a3-linux-x64",
          "tarballSha256": "f29f964ff1665abd75355dbf343549badc8b7577dc84ca8bbd18ec656fc42a64"
        },
        "win32-x64": {
          "release": "cyclotron-4782d9a281ef-ec1e0e845c3a-win32-x64",
          "tarballSha256": "3eecc57767a754cb839ff81fd107db5a524c06ca164a1e3757602d62844967e4"
        }
      }
    }
  },
  "dependencies": {
    "@volter/editor-core": "0.5.204",
    "@volter/editor-blender": "0.1.143",
    "@volter/editor-threejs": "0.5.204",
    "@volter/blender-engine": "0.1.141",
    "@volter/project": "0.5.204",
    "@volter/sdk": "0.5.204",
    "@volter/live": "0.5.204",
    "@modelcontextprotocol/sdk": "1.32.1",
    "typescript": "5.9.3",
    "undici": "7.29.1"
  },
  "bin": {
    "cyclotron": "./dist-node/cli.js"
  }
}
