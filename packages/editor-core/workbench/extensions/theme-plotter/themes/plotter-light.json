	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#8b918e"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical.python",
				"keyword.operator.wordlike"
			],
			"settings": {
				"foreground": "#e2571a"
			}
		},
		{
			"scope": [
				"variable.language",
				"variable.parameter",
				"meta.parameters variable",
				"variable.language.self",
				"variable.language.this"
			],
			"settings": {
				"foreground": "#6e5ba6"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#4e7f2a"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#6e5ba6"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#1c2121"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class",
				"support.type",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#1c2121"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#e2571a"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#6e5ba6"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#586060"
			}
		},
		{
			"scope": [
				"markup.heading"
			],
			"settings": {
				"foreground": "#1c2121",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#6e5ba6"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#c8431c"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"parameter": "#6e5ba6",
		"variable.defaultLibrary": "#1c2121",
		"selfParameter": "#6e5ba6",
		"keyword": "#e2571a"
	}
}
