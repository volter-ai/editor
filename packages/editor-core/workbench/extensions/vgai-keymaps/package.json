				"when": "vgai.stage.focused && vgai.document.kind != 'game' && vgai.keymap == 'blender'"
			},
			{
				"command": "vgai.view.rollRight",
				"key": "shift+NumPad6",
				"when": "vgai.stage.focused && vgai.document.kind != 'game' && vgai.keymap == 'blender'"
			},
			{
				"command": "vgai.view.projection",
				"key": "NumPad5",
				"when": "vgai.stage.focused && vgai.document.kind != 'game' && vgai.keymap == 'blender'"
			},
			{
				"command": "vgai.view.camera",
				"key": "NumPad0",
				"when": "vgai.stage.focused && vgai.document.kind != 'game' && vgai.keymap == 'blender'"
			}
		]
	}
}
