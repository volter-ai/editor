{
  "name": "@volter/editor-core",
  "author": "Volter AI, Inc.",
  "version": "0.5.65",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only AND Apache-2.0",
  "description": "Shared host, server and Code-OSS integration for Volter Editor.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/editor.git",
    "directory": "packages/editor-core"
  },
  "files": [
    "src",
    "LICENSE",
    "LICENSE-APACHE",
    "NOTICE",
    "vite-plugin-*.ts",
    "dist/build",
    "scripts/build-plugins.mjs",
    "server",
    "dist/server",
    "scripts/build-session.mjs",
    "dist-server",
    "scripts/build-server.mjs",
    "BUNDLED_NOTICES"
  ],
  "exports": {
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./src/*"
    },
    "./build/*": {
      "types": "./vite-plugin-*.ts",
      "default": "./dist/build/vite-plugin-*.js"
    },
    "./server/*": {
      "types": "./server/*.ts",
      "default": "./dist/server/*.js"
    },
    "./server/packaged": "./dist-server/packaged.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:plugins": "node scripts/build-plugins.mjs",
    "prepack": "npm run build:plugins && npm run build:session && npm run build:server",
    "build:session": "node scripts/build-session.mjs",
    "test:session": "npm run build:session && node --test test/session.test.mjs",
    "build:server": "node scripts/build-server.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.0",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.4",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/rapier": "2.2.0",
    "@sparkjsdev/spark": "2.1.0",
    "@storybook/react": "10.6.0",
    "mediabunny": "1.56.2",
    "pixi.js": "^8.6.0",
    "postprocessing": "6.38.3",
    "quarks.core": "0.16.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rrweb": "2.1.6",
    "storybook": "10.6.0",
    "three": "0.180.0",
    "three.quarks": "0.16.0",
    "typescript": "5.9.3",
    "zod": "4.3.6",
    "@volter/editor-project": "0.5.65",
    "@volter/editor-sdk": "0.5.65",
    "@volter/editor-threejs": "0.5.65",
    "@volter/editor-live": "0.5.65",
    "vite": "^6.4.3",
    "express": "^5.2.1",
    "chokidar": "^5.0.0",
    "ws": "^8.21.0",
    "@volter-ai-dev/supercode-harness-sdk": "0.3.30",
    "@volter-ai-dev/supercode-ui": "^0.1.83",
    "jsonc-parser": "3.3.1",
    "es-module-lexer": "^1.7.0",
    "@babel/parser": "7.29.0",
    "@babel/traverse": "7.29.0",
    "@babel/generator": "7.29.1",
    "@babel/types": "7.29.7",
    "ztrack": "1.5.5",
    "@volter-ai-dev/supercode-client": "0.3.49",
    "fflate": "0.8.3",
    "tinyglobby": "0.2.17",
    "postcss": "8.5.28",
    "esbuild": "0.25.12",
    "picomatch": "4.0.7",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/ws": "8.18.1",
    "@types/babel__traverse": "7.28.0",
    "@types/babel__generator": "7.27.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@volter-ai-dev/supercode": "0.4.38"
  }
}
