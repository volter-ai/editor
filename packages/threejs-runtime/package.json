{
  "name": "@volter/threejs-runtime",
  "author": "Volter AI, Inc.",
  "license": "Apache-2.0",
  "version": "0.5.64",
  "private": true,
  "description": "THE THREE.JS SHIPPED TWIN: what a shipped game carries because its world is three.js — the renderer setup and render features, the asset loaders and asset-format descriptors, the Object3D marks the editor reads, Rapier-over-three physics, recast navigation, the three animation mixer and its xstate binding, and the scene-capture the ingest seam mounts through.",
  "keywords": [
    "vgai",
    "three",
    "game-engine"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/editor.git",
    "directory": "packages/threejs-runtime"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./src/*"
    }
  },
  "files": [
    "src",
    "vendor",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@recast-navigation/three": "^0.43.0",
    "@sparkjsdev/spark": "^2.1.0",
    "@volter/editor-project": "0.5.64",
    "n8ao": "^1.10.1",
    "postprocessing": "^6.38.0",
    "recast-navigation": "^0.43.0",
    "three": "^0.180.0",
    "three.quarks": "^0.16.0",
    "xstate": "^5.32.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  }
}
