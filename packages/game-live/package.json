{
  "name": "@volter/game-live",
  "author": "Volter AI, Inc.",
  "version": "0.5.66",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "Apache-2.0",
  "description": "Attach to a Volter Game Editor session and drive the running game: { editor, game, page, tools, session }.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/editor.git",
    "directory": "packages/game-live"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@volter/editor-live": "0.5.66",
    "@volter/editor-sdk": "0.5.66",
    "undici": "^7.28.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.58.2 <2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "prepack": "npm run build"
  }
}
