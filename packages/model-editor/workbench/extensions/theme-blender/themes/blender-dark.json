		{
			"scope": [
				"comment"
			],
			"settings": {
				"foreground": "#969696"
			}
		},
		{
			"scope": [
				"keyword",
				"storage"
			],
			"settings": {
				"foreground": "#ff7f7f"
			}
		},
		{
			"scope": [
				"string"
			],
