{
  "name": "@volter/model-editor",
  "author": "Volter AI, Inc.",
  "version": "0.5.189",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only AND GPL-3.0-or-later AND MIT",
  "description": "A free, open-source game editor by VideoGame AI using Blender 5.2 compiled to WebAssembly, Code-OSS, three.js, TypeScript and React.",
  "homepage": "https://model-editor.videogame.ai",
  "keywords": [
    "blender",
    "three.js",
    "game editor",
    "webassembly",
    "code-oss",
    "react",
    "mcp",
    "codex",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/editor.git",
    "directory": "packages/model-editor"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "LICENSE",
    "LICENSE-BLENDER",
    "NOTICE",
    "dist-node",
    "presets.mjs",
    "starter",
    "LICENSE-MCP",
    "BUNDLED_NOTICES"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "build:node": "node scripts/build-node.mjs",
    "typecheck": "tsc -p tsconfig.node.json",
    "test": "npm run build:node && node --test test/first-run.test.mjs"
  },
  "volter": {
    "product": {
      "entry": "./src/index.ts",
      "displayName": "Volter Model Editor",
      "install": "npx @volter/model-editor create my-game",
      "colorTheme": "dark",
      "upgrade": true,
      "workbench": {
        "darwin-arm64": {
          "release": "model-editor-f16dc165c0df-bcb58a166b10-darwin-arm64",
          "tarballSha256": "5d9b987274f2f06355041b272c637d9e471122af9a3ab0139930e314d1852c01"
        },
        "linux-x64": {
          "release": "model-editor-f16dc165c0df-29e1a79727a1-linux-x64",
          "tarballSha256": "9e91ba4ba8540b468eaed6b329902e8bd3ba80af5126b2b282096491fd8ca4ff"
        },
        "win32-x64": {
          "release": "model-editor-f16dc165c0df-91d8be2deef0-win32-x64",
          "tarballSha256": "074725b6d275dcbe543932f09e76a981c1365698c9ef1c94ca05fbd4760848d0"
        }
      }
    }
  },
  "dependencies": {
    "@volter/editor-core": "0.5.189",
    "@volter/editor-blender": "0.1.128",
    "@volter/editor-threejs": "0.5.189",
    "@volter/blender-engine": "0.1.126",
    "@volter/editor-project": "0.5.189",
    "@volter/editor-sdk": "0.5.189",
    "@volter/editor-live": "0.5.189",
    "@modelcontextprotocol/sdk": "1.32.1",
    "undici": "7.29.1"
  },
  "bin": {
    "volter-model-editor": "./dist-node/cli.js"
  }
}
