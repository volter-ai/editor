{
  "name": "@volter/model-editor",
  "author": "Volter AI, Inc.",
  "version": "0.5.189",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only AND GPL-3.0-or-later AND MIT",
  "description": "A free, open-source game editor by VideoGame AI using Blender 5.2 compiled to WebAssembly, Code-OSS, three.js, TypeScript and React.",
  "homepage": "https://model-editor.videogame.ai",
  "keywords": [
    "blender",
    "three.js",
    "game editor",
    "webassembly",
    "code-oss",
    "react",
    "mcp",
    "codex",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/editor.git",
    "directory": "packages/model-editor"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "LICENSE",
    "LICENSE-BLENDER",
    "NOTICE",
    "dist-node",
    "presets.mjs",
    "starter",
    "LICENSE-MCP",
    "BUNDLED_NOTICES"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "build:node": "node scripts/build-node.mjs",
    "typecheck": "tsc -p tsconfig.node.json",
    "test": "npm run build:node && node --test test/first-run.test.mjs"
  },
  "volter": {
    "product": {
      "entry": "./src/index.ts",
      "displayName": "Volter Model Editor",
      "colorTheme": "dark",
      "workbench": {
        "darwin-arm64": {
          "release": "model-editor-f16dc165c0df-265ec54a5aaa-darwin-arm64",
          "tarballSha256": "1dee8d56404844f45b4c4ee629b9957e7f36a25093bcf03bff666455da9087ef"
        },
        "linux-x64": {
          "release": "model-editor-f16dc165c0df-265ec54a5aaa-linux-x64",
          "tarballSha256": "132689868bf5e681b317efc65b2ff060d8c1fbe807dd6b4290e352461e52f33c"
        },
        "win32-x64": {
          "release": "model-editor-f16dc165c0df-265ec54a5aaa-win32-x64",
          "tarballSha256": "aba673812e515538b3d51f6e284081b259c1279fe156b2c5af084607a761f1ea"
        }
      }
    }
  },
  "dependencies": {
    "@volter/editor-core": "0.5.189",
    "@volter/editor-blender": "0.1.128",
    "@volter/editor-threejs": "0.5.189",
    "@volter/blender-engine": "0.1.126",
    "@volter/editor-project": "0.5.189",
    "@volter/editor-sdk": "0.5.189",
    "@volter/editor-live": "0.5.189",
    "@modelcontextprotocol/sdk": "1.32.1",
    "undici": "7.29.1"
  },
  "bin": {
    "volter-model-editor": "./dist-node/cli.js"
  }
}
