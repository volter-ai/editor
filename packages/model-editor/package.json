{
  "name": "@volter/model-editor",
  "author": "Volter AI, Inc.",
  "version": "0.5.180",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only AND GPL-3.0-or-later AND MIT",
  "description": "A free, open-source game editor by VideoGame AI using Blender 5.2 compiled to WebAssembly, Code-OSS, three.js, TypeScript and React.",
  "homepage": "https://model-editor.videogame.ai",
  "keywords": [
    "blender",
    "three.js",
    "game editor",
    "webassembly",
    "code-oss",
    "react",
    "mcp",
    "codex",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/editor.git",
    "directory": "packages/model-editor"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "LICENSE",
    "LICENSE-BLENDER",
    "NOTICE",
    "dist-node",
    "presets.mjs",
    "starter",
    "LICENSE-MCP",
    "BUNDLED_NOTICES"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "build:node": "node scripts/build-node.mjs",
    "typecheck": "tsc -p tsconfig.node.json"
  },
  "volter": {
    "product": {
      "entry": "./src/index.ts",
      "displayName": "Volter Model Editor",
      "colorTheme": "dark",
      "workbench": {
        "release": "model-editor-f16dc165c0df-309e2d553050-darwin-arm64",
        "tarballSha256": "ff029da671708a71f309d9a00203cbd92261ce9719df32e70ef316ffaac915cc"
      }
    }
  },
  "dependencies": {
    "@volter/editor-core": "0.5.180",
    "@volter/editor-blender": "0.1.119",
    "@volter/editor-threejs": "0.5.180",
    "@volter/blender-engine": "0.1.117",
    "@volter/editor-project": "0.5.180",
    "@volter/editor-sdk": "0.5.180",
    "@volter/editor-live": "0.5.180",
    "@modelcontextprotocol/sdk": "1.30.0",
    "undici": "7.29.1"
  },
  "bin": {
    "volter-model-editor": "./dist-node/cli.js"
  }
