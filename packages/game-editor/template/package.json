{
  "name": "my-game",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "vgai": "volter-game-editor",
    "dev": "volter-game-editor edit .",
    "dev:standalone": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/patch-drei-stats-gl.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p server/tsconfig.json",
    "validate-assets": "npx tsx validate-assets.ts .",
    "validate-manifest": "npx tsx validate-manifest.ts vgai.project.json",
    "check-idioms": "npx tsx check-idioms.ts .",
    "server": "npx tsx --tsconfig server/tsconfig.json server/main.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^4.0.14",
    "@colyseus/sdk": "^0.17.34",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@volter/editor-project": "^0.5.65",
    "@volter/game-runtime": "^0.5.65",
    "@volter/threejs-runtime": "^0.5.65",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "three": "^0.180.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@colyseus/ws-transport": "^0.17.9",
    "@storybook/react": "^9.1.20",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@volter/editor-core": "^0.5.65",
    "@volter/editor-game": "^0.5.65",
    "@volter/editor-live": "^0.5.65",
    "@volter/editor-sdk": "^0.5.65",
    "@volter/game-editor": "^0.5.65",
    "@volter/game-live": "^0.5.65",
    "colyseus": "^0.17.8",
    "storybook": "^9.1.20",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "ztrack": "^1.5.5"
  },
  "overrides": {
    "@react-three/drei": {
      "stats-gl": "4.2.3"
    }
  }
}
