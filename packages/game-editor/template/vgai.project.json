{
  "$schema": "./node_modules/@volter/editor-project/schemas/vgai-project.schema.json",
  "manifestVersion": 2,
  "name": "My Game",
  "appId": "com.example.mygame",
  "version": "0.1.0",
  "engine": {
    "version": "0.5.57"
  },
  "resolution": {
    "width": 1280,
    "height": 720
  },
  "configurations": [
    { "id": "web", "kind": "bundle", "script": "build", "args": ["--base", "./"] },
    {
      "id": "server",
      "kind": "process",
      "entry": "server/main.ts",
      "command": "npx tsx --tsconfig server/tsconfig.json server/main.ts",
      "port": 2567,
      "env": { "VGAI_ROOM_MONITOR": "1" }
    },
    { "id": "play + server", "kind": "compound", "run": ["server", "play"] }
  ],
  "roots": [
    {
      "id": "world",
      "adapter": "three",
      "entry": "src/world.tsx"
    }
  ]
}
